# Fibonacci Calculator
# Stores the Fibonacci numbers starting in memory location 256
# for the number of iterations specified in R14
set 2 R15 # Address increment
set 2 R14 # Loop counter
set 1 R13 # Decrement
set 0 R12
set 8 R0
barrel R13 R0 R0 # Set R0 to 256
add R15 R0 R1 # Set R1 to 258
add R15 R1 R2 # Set R2 to 260
storew R0 R13 # Initialise f_0
storew R1 R13 # Iniitalise f_1
set 4 R8
loadpc R10
add R10 R8 R10 # R10 should point to start of main loop
loadw R0 R3 # Start of main loop
loadw R1 R4
add R3 R4 R5 # compute sub of previous two
storew R2 R5
add R0 R15 R0
add R1 R15 R1
add R2 R15 R2
sub R14 R13 R14 # Decrement loop counter
loadpc R3
set 10 R4
add R3 R4 R3
branchzero R3 R14 # Jump to halt if done
branchzero R10 R12 # Back to main loop
halt